<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HabitosNet.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:HabitosNet.Views"
    Title="HabitosNet">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="home" />
        <ShellContent
            Title="Estudiar"
            ContentTemplate="{DataTemplate views:StudyPage}"
            Route="estudiar" />
        <ShellContent
            Title="Histórico"
            ContentTemplate="{DataTemplate views:HistoryPage}"
            Route="historico" />
    </TabBar>

</Shell>
