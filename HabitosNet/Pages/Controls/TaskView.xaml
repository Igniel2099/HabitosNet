<?xml version="1.0" encoding="utf-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:pageModels="clr-namespace:HabitosNet.PageModels"
        xmlns:models="clr-namespace:HabitosNet.Models"
        x:Class="HabitosNet.Pages.Controls.TaskView" x:DataType="models:ProjectTask"
        Style="{StaticResource FormCard}" Padding="8,10">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" MinimumHeightRequest="48">
        <CheckBox WidthRequest="48" HeightRequest="48" VerticalOptions="Center"
                  IsChecked="{Binding IsCompleted, Mode=OneWay}" CheckedChanged="CheckBox_CheckedChanged"
                  SemanticProperties.Description="{Binding Title, StringFormat='Completar: {0}'}" />
        <Label Grid.Column="1" Text="{Binding Title}" VerticalOptions="Center" LineBreakMode="WordWrap">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="TextDecorations" Value="Strikethrough" />
                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                </DataTrigger>
            </Label.Triggers>
        </Label>
        <Button Grid.Column="2" Text="Editar" VerticalOptions="Center" Style="{StaticResource SecondaryButton}" Padding="12,8"
                Command="{Binding NavigateToTaskCommand, Source={RelativeSource AncestorType={x:Type pageModels:IProjectTaskPageModel}}, x:DataType=pageModels:IProjectTaskPageModel}"
                CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Title, StringFormat='Editar tarea: {0}'}" />
    </Grid>
</Border>
