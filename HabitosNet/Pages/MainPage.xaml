<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:HabitosNet.PageModels"
             xmlns:models="clr-namespace:HabitosNet.Models"
             xmlns:controls="clr-namespace:HabitosNet.Pages.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="HabitosNet.Pages.MainPage" x:Name="OverviewPage"
             x:DataType="pageModels:MainPageModel" Title="Inicio" SizeChanged="OnSizeChanged">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
            BindingContext="{Binding BindingContext, Source={x:Reference OverviewPage}, x:DataType=ContentPage}"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>
    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="Not" />
    </ContentPage.Resources>
    <Grid Padding="{StaticResource LayoutPadding}" RowDefinitions="Auto,*" RowSpacing="16"
          MaximumWidthRequest="1240" HorizontalOptions="Fill">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="4">
                <Label Text="Un paso cada día" Style="{StaticResource PageTitle}" />
                <Label Text="{Binding Today}" Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>
            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               WidthRequest="32" SemanticProperties.Description="Cargando tareas" />
        </Grid>
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding VisibleTasks}" SelectionMode="None" ItemSizingStrategy="MeasureAllItems">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="20" Padding="0,0,0,12">
                        <Grid x:Name="OverviewGrid" ColumnDefinitions="*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="16">
                            <VerticalStackLayout Spacing="16">
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <Border Style="{StaticResource FormCard}" Padding="12">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding PendingCount}" FontSize="28" FontAttributes="Bold" />
                                            <Label Text="Pendientes" Style="{StaticResource MutedLabel}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource FormCard}" Padding="12">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding CompletedCount}" FontSize="28" FontAttributes="Bold" />
                                            <Label Text="Hechas" Style="{StaticResource MutedLabel}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource FormCard}" Padding="12">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding ProjectCount}" FontSize="28" FontAttributes="Bold" />
                                            <Label Text="Proyectos" Style="{StaticResource MutedLabel}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                                <FlexLayout Wrap="Wrap" AlignItems="Start">
                                    <Button Text="+ Nueva tarea" Command="{Binding AddTaskCommand}" Style="{StaticResource PrimaryButton}"
                                            Margin="0,0,8,8" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
                                    <Button Text="Ver proyectos" Command="{Binding ShowProjectsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                                    <Button Text="Actualizar" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" />
                                </FlexLayout>
                                <Button x:Name="SummaryToggle" Text="Ver resumen por categoría" Clicked="OnSummaryClicked"
                                        Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" />
                            </VerticalStackLayout>
                            <Border x:Name="SummaryPanel" Grid.Row="1" Style="{StaticResource FormCard}" IsVisible="False">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Pendientes por categoría" Style="{StaticResource SectionTitle}" />
                                    <controls:CategoryChart HeightRequest="210" Padding="0" Margin="0" IsVisible="{Binding HasCategoryData}" />
                                    <Label Text="Sin tareas pendientes. ¡Buen trabajo!" Style="{StaticResource MutedLabel}"
                                           IsVisible="{Binding HasCategoryData, Converter={StaticResource Not}}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Tus tareas" Style="{StaticResource SectionTitle}" />
                            <Label Text="{Binding TaskListHint}" Style="{StaticResource MutedLabel}" />
                            <FlexLayout Wrap="Wrap" AlignItems="Center" JustifyContent="SpaceBetween">
                                <HorizontalStackLayout Spacing="4">
                                    <CheckBox IsChecked="{Binding ShowCompleted}" MinimumHeightRequest="48" MinimumWidthRequest="48"
                                              SemanticProperties.Description="Mostrar tareas completadas" />
                                    <Label Text="Ver completadas" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Button Text="Eliminar completadas" Command="{Binding CleanTasksCommand}"
                                        Style="{StaticResource DangerButton}" IsVisible="{Binding HasCompletedTasks}" Margin="0,4" />
                            </FlexLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="12" HorizontalOptions="Fill">
                        <Label Text="{Binding EmptyMessage}" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding EmptyHint}" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                        <Button Text="+ Crear proyecto" Command="{Binding AddProjectCommand}" Style="{StaticResource SecondaryButton}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProjectTask">
                        <controls:TaskView TaskCompletedCommand="{Binding TaskCompletedCommand, Source={RelativeSource AncestorType={x:Type pageModels:MainPageModel}}, x:DataType=pageModels:MainPageModel}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer><BoxView HeightRequest="16" Color="Transparent" /></CollectionView.Footer>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
