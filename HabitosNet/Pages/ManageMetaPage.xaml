<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:HabitosNet.PageModels"
             xmlns:models="clr-namespace:HabitosNet.Models"
             xmlns:pages="clr-namespace:HabitosNet.Pages"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="pageModels:ManageMetaPageModel"
             x:Class="HabitosNet.Pages.ManageMetaPage"
             x:Name="MetaPage"
             Title="Categorías y etiquetas" SizeChanged="OnPageSizeChanged">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference MetaPage}, x:DataType=ContentPage}"
            EventName="Appearing" Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>
    <ContentPage.Resources>
        <pages:MetaColorPreviewConverter x:Key="ColorPreviewConverter" />
        <Style x:Key="InvalidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#B42318, Dark=#FDA29B}" />
        </Style>
        <Style x:Key="MetaItemCard" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#DCE3EB, Dark=#43505E}" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
    </ContentPage.Resources>

    <ScrollView x:Name="PageScroll" Padding="16">
        <VerticalStackLayout x:Name="FormLayout" MaximumWidthRequest="920"
                             HorizontalOptions="Center" Spacing="20">
            <VerticalStackLayout Spacing="6">
                <Label Text="Todo en su sitio" Style="{StaticResource PageTitle}" />
                <Label Text="Agrupa tus proyectos por categoría y añade etiquetas para encontrarlos con facilidad."
                       Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>

            <Label Text="{Binding ValidationMessage}" IsVisible="{Binding HasValidationMessage}"
                   TextColor="{AppThemeBinding Light=#B42318, Dark=#FDA29B}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" SemanticProperties.Description="Guardando o cargando organización" />

            <Grid x:Name="OrganizationGrid" RowDefinitions="Auto,Auto" ColumnDefinitions="*,0"
                  RowSpacing="16" ColumnSpacing="0" IsEnabled="{Binding CanSave}">
                <Border Style="{StaticResource FormCard}" VerticalOptions="Start">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Categorías" Style="{StaticResource SectionTitle}" />
                        <Label Text="Usa categorías para agrupar proyectos. Para eliminar una categoría en uso, reasigna antes sus proyectos."
                               Style="{StaticResource MutedLabel}" />
                        <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Categories}">
                            <BindableLayout.EmptyView>
                                <Label Text="Crea tu primera categoría, por ejemplo Personal o Trabajo."
                                       Style="{StaticResource MutedLabel}" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Category">
                                    <Border Style="{StaticResource MetaItemCard}">
                                        <VerticalStackLayout Spacing="8">
                                            <Label Text="Nombre" FontAttributes="Bold" />
                                            <Entry Text="{Binding Title}" Placeholder="Nombre de la categoría"
                                                   SemanticProperties.Description="Nombre de la categoría" />
                                            <Label Text="Color hexadecimal" Style="{StaticResource MutedLabel}" />
                                            <Grid ColumnDefinitions="*,40" ColumnSpacing="10">
                                            <Entry x:Name="CategoryColorEntry" Text="{Binding Color}" Placeholder="#147D73"
                                                   SemanticProperties.Description="Color de la categoría"
                                                   SemanticProperties.Hint="Escribe almohadilla y tres o seis caracteres hexadecimales">
                                                <Entry.Behaviors>
                                                    <toolkit:TextValidationBehavior InvalidStyle="{StaticResource InvalidEntryStyle}"
                                                        Flags="ValidateOnUnfocused" RegexPattern="^#(?:[0-9a-fA-F]{3}){1,2}$" />
                                                </Entry.Behaviors>
                                            </Entry>
                                            <BoxView Grid.Column="1" WidthRequest="32" HeightRequest="32" CornerRadius="8"
                                                     VerticalOptions="Center" HorizontalOptions="Center"
                                                     Color="{Binding Text, Source={x:Reference CategoryColorEntry}, x:DataType=Entry, Converter={StaticResource ColorPreviewConverter}}"
                                                     SemanticProperties.Description="Vista previa del color" />
                                            </Grid>
                                            <Button Text="Eliminar categoría" Style="{StaticResource DangerButton}"
                                                    Command="{Binding DeleteCategoryCommand, Source={RelativeSource AncestorType={x:Type pageModels:ManageMetaPageModel}}, x:DataType=pageModels:ManageMetaPageModel}"
                                                    CommandParameter="{Binding .}"
                                                    SemanticProperties.Description="{Binding Title, StringFormat='Eliminar categoría {0}'}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Button Text="+ Añadir categoría" Command="{Binding AddCategoryCommand}"
                                Style="{StaticResource SecondaryButton}" />
                        <Button Text="Guardar categorías" Command="{Binding SaveCategoriesCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="TagsCard" Grid.Row="1" Style="{StaticResource FormCard}" VerticalOptions="Start">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Etiquetas" Style="{StaticResource SectionTitle}" />
                        <Label Text="Un proyecto puede tener varias etiquetas. Usa nombres cortos, como Salud, Casa o Prioridad."
                               Style="{StaticResource MutedLabel}" />
                        <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Tags}">
                            <BindableLayout.EmptyView>
                                <Label Text="Aún no hay etiquetas. Añade una para empezar."
                                       Style="{StaticResource MutedLabel}" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Tag">
                                    <Border Style="{StaticResource MetaItemCard}">
                                        <VerticalStackLayout Spacing="8">
                                            <Label Text="Nombre" FontAttributes="Bold" />
                                            <Entry Text="{Binding Title}" Placeholder="Nombre de la etiqueta"
                                                   SemanticProperties.Description="Nombre de la etiqueta" />
                                            <Label Text="Color hexadecimal" Style="{StaticResource MutedLabel}" />
                                            <Grid ColumnDefinitions="*,40" ColumnSpacing="10">
                                            <Entry x:Name="TagColorEntry" Text="{Binding Color}" Placeholder="#147D73"
                                                   SemanticProperties.Description="Color de la etiqueta"
                                                   SemanticProperties.Hint="Escribe almohadilla y tres o seis caracteres hexadecimales">
                                                <Entry.Behaviors>
                                                    <toolkit:TextValidationBehavior InvalidStyle="{StaticResource InvalidEntryStyle}"
                                                        Flags="ValidateOnUnfocused" RegexPattern="^#(?:[0-9a-fA-F]{3}){1,2}$" />
                                                </Entry.Behaviors>
                                            </Entry>
                                            <BoxView Grid.Column="1" WidthRequest="32" HeightRequest="32" CornerRadius="8"
                                                     VerticalOptions="Center" HorizontalOptions="Center"
                                                     Color="{Binding Text, Source={x:Reference TagColorEntry}, x:DataType=Entry, Converter={StaticResource ColorPreviewConverter}}"
                                                     SemanticProperties.Description="Vista previa del color" />
                                            </Grid>
                                            <Button Text="Eliminar etiqueta" Style="{StaticResource DangerButton}"
                                                    Command="{Binding DeleteTagCommand, Source={RelativeSource AncestorType={x:Type pageModels:ManageMetaPageModel}}, x:DataType=pageModels:ManageMetaPageModel}"
                                                    CommandParameter="{Binding .}"
                                                    SemanticProperties.Description="{Binding Title, StringFormat='Eliminar etiqueta {0}'}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Button Text="+ Añadir etiqueta" Command="{Binding AddTagCommand}"
                                Style="{StaticResource SecondaryButton}" />
                        <Button Text="Guardar etiquetas" Command="{Binding SaveTagsCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource FormCard}" IsEnabled="{Binding CanSave}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Datos de ejemplo" Style="{StaticResource SectionTitle}" />
                    <Label Text="Restaurar los ejemplos elimina tus proyectos, tareas, categorías y etiquetas actuales."
                           Style="{StaticResource MutedLabel}" />
                    <Button Text="Restaurar datos de ejemplo" Command="{Binding ResetCommand}"
                            Style="{StaticResource DangerButton}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
