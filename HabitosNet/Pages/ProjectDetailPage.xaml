<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:HabitosNet.PageModels"
             xmlns:models="clr-namespace:HabitosNet.Models"
             xmlns:controls="clr-namespace:HabitosNet.Pages.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="HabitosNet.Pages.ProjectDetailPage"
             x:DataType="pageModels:ProjectDetailPageModel"
             Title="Proyecto"
             SizeChanged="OnPageSizeChanged">
    <ScrollView x:Name="PageScroll" Padding="16">
        <VerticalStackLayout x:Name="FormLayout" MaximumWidthRequest="920"
                             HorizontalOptions="Center" Spacing="20">
            <VerticalStackLayout Spacing="6">
                <Label Text="Tu proyecto" Style="{StaticResource PageTitle}" />
                <Label Text="Define lo que quieres conseguir y divídelo en tareas."
                       Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>

            <Label Text="{Binding ValidationMessage}" IsVisible="{Binding HasValidationMessage}"
                   TextColor="{AppThemeBinding Light=#B42318, Dark=#FDA29B}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" SemanticProperties.Description="Guardando o cargando proyecto" />

            <Grid x:Name="DetailsGrid" RowDefinitions="Auto,Auto" ColumnDefinitions="*,0"
                  ColumnSpacing="0" RowSpacing="16" IsEnabled="{Binding CanSave}">
                <Border x:Name="DetailsCard" Style="{StaticResource FormCard}" VerticalOptions="Start">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Detalles" Style="{StaticResource SectionTitle}" />
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Nombre del proyecto *" FontAttributes="Bold" />
                            <Entry Text="{Binding Name}" Placeholder="Ej. Aprender un idioma"
                                   ReturnType="Next" SemanticProperties.Description="Nombre del proyecto, obligatorio" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Descripción" FontAttributes="Bold" />
                            <Editor Text="{Binding Description}" Placeholder="¿Qué quieres conseguir?"
                                    AutoSize="TextChanges" MinimumHeightRequest="112"
                                    SemanticProperties.Description="Descripción opcional del proyecto" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Categoría (opcional)" FontAttributes="Bold" />
                            <Picker Title="Selecciona una categoría"
                                    ItemsSource="{Binding Categories}"
                                    ItemDisplayBinding="{Binding Title, x:DataType=models:Category}"
                                    SelectedItem="{Binding Category}" SelectedIndex="{Binding CategoryIndex}"
                                    SemanticProperties.Description="Categoría del proyecto" />
                            <Label Text="Puedes crear categorías en Categorías y etiquetas."
                                   Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="OrganizationCard" Grid.Row="1" Style="{StaticResource FormCard}" VerticalOptions="Start">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Personaliza tu proyecto" Style="{StaticResource SectionTitle}" />
                        <Label Text="Icono" FontAttributes="Bold" />
                        <CollectionView HeightRequest="128" SelectionMode="Single"
                                        SelectedItem="{Binding Icon}"
                                        SelectionChangedCommand="{Binding IconSelectedCommand}"
                                        SelectionChangedCommandParameter="{Binding Icon}"
                                        ItemsSource="{Binding Icons}"
                                        SemanticProperties.Description="Elige un icono para el proyecto">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="4" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:IconData">
                                    <Grid HeightRequest="56" MinimumWidthRequest="48" RowDefinitions="*,4"
                                          SemanticProperties.Description="{Binding Description}">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                                        <Setter TargetName="SelectedIndicator" Property="BoxView.IsVisible" Value="False" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#DCF5EF, Dark=#173F3A}" />
                                                        <Setter TargetName="SelectedIndicator" Property="BoxView.IsVisible" Value="True" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Label Text="{Binding Icon}" FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                               FontSize="26" VerticalOptions="Center" HorizontalOptions="Center" />
                                        <BoxView x:Name="SelectedIndicator" Grid.Row="1" Color="{StaticResource Primary}"
                                                 HeightRequest="4" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Label Text="Etiquetas" FontAttributes="Bold" />
                        <Label Text="Toca una etiqueta para seleccionarla o quitarla. Son opcionales."
                               Style="{StaticResource MutedLabel}" />
                        <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Start"
                                    BindableLayout.ItemsSource="{Binding AllTags}">
                            <BindableLayout.EmptyView>
                                <Label Text="Aún no hay etiquetas. Puedes crearlas en Categorías y etiquetas."
                                       Style="{StaticResource MutedLabel}" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Tag">
                                    <Button Text="{Binding Title}" Margin="0,0,8,8" Style="{StaticResource SecondaryButton}"
                                            LineBreakMode="WordWrap" FlexLayout.Shrink="1"
                                            Command="{Binding ToggleTagCommand, Source={RelativeSource AncestorType={x:Type pageModels:ProjectDetailPageModel}}, x:DataType=pageModels:ProjectDetailPageModel}"
                                            CommandParameter="{Binding .}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Button Text="Guardar proyecto" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"
                    Style="{StaticResource PrimaryButton}" />

            <Border Style="{StaticResource FormCard}" IsEnabled="{Binding CanSave}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Tareas del proyecto" Style="{StaticResource SectionTitle}" />
                    <Label Text="Marca lo que ya has hecho. Pulsa Editar para cambiar una tarea."
                           Style="{StaticResource MutedLabel}" />
                    <Button Text="+ Añadir tarea" Command="{Binding AddTaskCommand}" Style="{StaticResource SecondaryButton}" />
                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Tasks}">
                        <BindableLayout.EmptyView>
                            <Label Text="Todavía no hay tareas. Añade el primer paso de tu proyecto."
                                   Style="{StaticResource MutedLabel}" Margin="0,8" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ProjectTask">
                                <controls:TaskView TaskCompletedCommand="{Binding TaskCompletedCommand, Source={RelativeSource AncestorType={x:Type pageModels:ProjectDetailPageModel}}, x:DataType=pageModels:ProjectDetailPageModel}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="Eliminar tareas completadas" Command="{Binding CleanTasksCommand}"
                            IsVisible="{Binding HasCompletedTasks}" Style="{StaticResource DangerButton}" />
                </VerticalStackLayout>
            </Border>
            <Button Text="Eliminar proyecto" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}"
                    Style="{StaticResource DangerButton}" IsEnabled="{Binding CanSave}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
