<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:HabitosNet.PageModels"
             xmlns:models="clr-namespace:HabitosNet.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="HabitosNet.Pages.ProjectListPage" x:Name="ProjectList"
             x:DataType="pageModels:ProjectListPageModel" Title="Proyectos" SizeChanged="OnSizeChanged">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
            BindingContext="{Binding BindingContext, Source={x:Reference ProjectList}, x:DataType=ContentPage}"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>
    <Grid Padding="{StaticResource LayoutPadding}" RowDefinitions="Auto,Auto,*" RowSpacing="16"
          MaximumWidthRequest="1240" HorizontalOptions="Fill">
        <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Center">
            <VerticalStackLayout Spacing="4" Margin="0,0,12,12">
                <Label Text="Tus proyectos" Style="{StaticResource PageTitle}" />
                <Label Text="Organiza tus objetivos en pasos pequeños." Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>
            <Button Text="+ Nuevo proyecto" Command="{Binding AddProjectCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,12" />
        </FlexLayout>
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="8">
            <SearchBar Text="{Binding SearchText}" Placeholder="Buscar por nombre o descripción" FontSize="16"
                       SemanticProperties.Description="Buscar proyectos" />
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <Label Text="{Binding ResultSummary}" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" WidthRequest="24" HeightRequest="24" />
            </Grid>
        </Grid>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Projects}" SelectionMode="None" ItemSizingStrategy="MeasureAllItems">
            <CollectionView.ItemsLayout>
                <GridItemsLayout x:Name="ProjectLayout" Orientation="Vertical" Span="1" HorizontalItemSpacing="16" VerticalItemSpacing="16" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="12">
                    <Label Text="{Binding EmptyTitle}" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding EmptyDescription}" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Project">
                    <Border Style="{StaticResource FormCard}">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                            <Label Text="{Binding Icon}" FontFamily="{x:Static fonts:FluentUI.FontFamily}" FontSize="28"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Label Grid.Row="1" Text="{Binding Name}" FontSize="21" FontAttributes="Bold" LineBreakMode="WordWrap" />
                            <Label Grid.Row="2" Text="{Binding Description}" Style="{StaticResource MutedLabel}" LineBreakMode="WordWrap" />
                            <Label Grid.Row="3" Text="{Binding TaskSummary}" FontSize="14" />
                            <ProgressBar Grid.Row="4" Progress="{Binding Progress}" ProgressColor="{StaticResource Primary}" />
                            <Button Grid.Row="5" Text="Abrir proyecto" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding NavigateToProjectCommand, Source={RelativeSource AncestorType={x:Type pageModels:ProjectListPageModel}}, x:DataType=pageModels:ProjectListPageModel}"
                                    CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Name, StringFormat='Abrir proyecto {0}'}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer><BoxView HeightRequest="16" Color="Transparent" /></CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>
