<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModel="clr-namespace:HabitosNet.PageModels"
             xmlns:models="clr-namespace:HabitosNet.Models"
             x:DataType="pageModel:TaskDetailPageModel"
             x:Class="HabitosNet.Pages.TaskDetailPage"
             Title="Tarea" SizeChanged="OnPageSizeChanged">
    <ScrollView x:Name="PageScroll" Padding="16">
        <VerticalStackLayout x:Name="FormLayout" MaximumWidthRequest="920"
                             HorizontalOptions="Center" Spacing="20">
            <VerticalStackLayout Spacing="6">
                <Label Text="Un paso más" Style="{StaticResource PageTitle}" />
                <Label Text="Escribe una acción concreta y asígnala a un proyecto."
                       Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>

            <Label Text="{Binding ValidationMessage}" IsVisible="{Binding HasValidationMessage}"
                   TextColor="{AppThemeBinding Light=#B42318, Dark=#FDA29B}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" SemanticProperties.Description="Guardando o cargando tarea" />

            <Border Style="{StaticResource FormCard}" IsEnabled="{Binding CanSave}">
                <VerticalStackLayout Spacing="20">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="¿Qué necesitas hacer? *" FontAttributes="Bold" />
                        <Entry Text="{Binding Title}" Placeholder="Ej. Leer diez páginas"
                               SemanticProperties.Description="Nombre de la tarea, obligatorio" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsExistingProject}">
                        <Label Text="Proyecto *" FontAttributes="Bold" />
                        <Picker Title="Selecciona un proyecto"
                                ItemsSource="{Binding Projects}"
                                ItemDisplayBinding="{Binding Name, x:DataType=models:Project}"
                                SelectedItem="{Binding Project}" SelectedIndex="{Binding SelectedProjectIndex}"
                                SemanticProperties.Description="Proyecto, obligatorio para guardar la tarea" />
                        <Label Text="Cada tarea debe pertenecer a un proyecto. Si no tienes ninguno, crea primero un proyecto."
                               Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>

                    <Border Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light=#DCF5EF, Dark=#173F3A}" IsVisible="False">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsExistingProject}" Value="False">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="Esta tarea se añadirá al proyecto que estás creando. Al volver, pulsa Guardar proyecto para conservarlo todo." />
                    </Border>

                    <Grid ColumnDefinitions="48,*" ColumnSpacing="8">
                        <CheckBox IsChecked="{Binding IsCompleted}" VerticalOptions="Center"
                                  SemanticProperties.Description="Marcar tarea como completada" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="Tarea completada" FontAttributes="Bold" />
                            <Label Text="Actívalo cuando hayas terminado." Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Guardar tarea" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"
                    Style="{StaticResource PrimaryButton}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsExistingProject}" Value="False">
                        <Setter Property="Text" Value="Guardar en el proyecto" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Text="Eliminar tarea" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}"
                    Style="{StaticResource DangerButton}" IsEnabled="{Binding CanSave}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
